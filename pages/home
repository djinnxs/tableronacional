# --- LOAD FILTERS DATA ---
@st.cache_data
def get_filter_options():
    with duckdb.connect() as con:
        anios_raw = [int(r[0]) for r in con.execute(f"SELECT DISTINCT ANIO FROM '{BASE_PARQUET}' ORDER BY 1 DESC").fetchall()]
        # Filter out unrealistic future years (like 2201)
        anios = [str(a) for a in anios_raw if 2000 <= a <= 2026]
        # Fetch ID and Evento pairs
        eventos_raw = con.execute(f"SELECT DISTINCT ID_SNVS_EVENTO, Evento FROM '{BASE_PARQUET}' ORDER BY Evento").fetchall()
        eventos_dict = {r[0]: r[1] for r in eventos_raw}
        provincias = [str(r[0]) for r in con.execute(f"SELECT DISTINCT Provincia FROM '{BASE_PARQUET}' ORDER BY 1").fetchall()]
        semanas = sorted([int(r[0]) for r in con.execute(f"SELECT DISTINCT SEMANA FROM '{BASE_PARQUET}'").fetchall()])
        semanas_options = ["Todas"] + [str(s) for s in semanas]
    return anios, eventos_dict, provincias, semanas_options

