# Function to format numbers for Argentine locale (e.g. 1.234,56)
def format_ar_number(val, decimals=0):
    try:
        if pd.isna(val): return ""
        if decimals == 0:
            return f"{int(val):,}".replace(",", ".")
        else:
            formatted = f"{val:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")
            return formatted
    except:
        return val

