                    df_disp['Poblacion'] = df_disp['Poblacion'].apply(lambda x: format_ar_number(x))
                    df_disp['Tasa'] = df_disp['Tasa'].apply(lambda x: format_ar_number(x, 2))
                
                st.dataframe(df_disp[display_cols].sort_values('Casos', ascending=False), hide_index=True, use_container_width=True)
            else:
                st.info("Sin datos provinciales")

        with m_col2:
            st.markdown("##### Nivel Departamental (País)")
            geojson_depto = load_geojson(DEPTO_GEOJSON)
            if not df_depto.empty:
                # Ensure Tasa and Poblacion exist even if pop lookup failed
                if 'Tasa' not in df_depto.columns:
                    df_depto['Tasa'] = 0.0
                if 'Poblacion' not in df_depto.columns:
                    df_depto['Poblacion'] = 0
                fig_depto = px.choropleth_mapbox(
                    data_frame=df_depto, geojson=geojson_depto, locations='id_departamento',
                    featureidkey='properties.in1', color=color_col, hover_name='Departamento',
                    hover_data=['Casos', 'Tasa', 'Poblacion'], color_continuous_scale=color_scale,
                    mapbox_style="carto-positron", zoom=3, center={"lat": -38.4161, "lon": -63.6167},
                    opacity=0.7, labels={'Casos': 'N° Casos', 'Tasa': 'Tasa'}
                )
                fig_depto.update_layout(margin={"r":0,"t":0,"l":0,"b":0}, height=500)
                st.plotly_chart(fig_depto, use_container_width=True)
                
                # Dynamic table columns
                display_cols = ['Departamento', 'Provincia', 'Casos']
                df_disp_depto = df_depto.copy()
                if metric_option == "Tasas (cada 100k hab.)":
                    display_cols += ['Poblacion', 'Tasa']
                    df_disp_depto['Poblacion'] = df_disp_depto['Poblacion'].apply(lambda x: format_ar_number(x))
                    df_disp_depto['Tasa'] = df_disp_depto['Tasa'].apply(lambda x: format_ar_number(x, 2))
                
                st.dataframe(df_disp_depto[display_cols].sort_values('Casos', ascending=False), hide_index=True, use_container_width=True)
            else:
                st.info("Sin datos departamentales")
    else:
        # Provincial View (One Map)
        geojson_depto = load_geojson(DEPTO_GEOJSON)
        if not df_depto.empty:
            if 'Tasa' not in df_depto.columns:
                df_depto['Tasa'] = 0.0
            if 'Poblacion' not in df_depto.columns:
                df_depto['Poblacion'] = 0
            fig = px.choropleth_mapbox(
                data_frame=df_depto, geojson=geojson_depto, locations='id_departamento',
                featureidkey='properties.in1', color=color_col, hover_name='Departamento',
                hover_data=['Casos', 'Tasa', 'Poblacion'], color_continuous_scale=color_scale,
                mapbox_style="carto-positron", zoom=5, center={"lat": -38.4161, "lon": -63.6167},
                opacity=0.7, labels={'Casos': 'N° Casos', 'Tasa': 'Tasa'}
            )
            fig.update_layout(margin={"r":0,"t":0,"l":0,"b":0}, height=600)
            st.plotly_chart(fig, use_container_width=True)
            
            # Dynamic table columns
            display_cols = ['Departamento', 'Casos']
            df_disp_single = df_depto.copy()
            if metric_option == "Tasas (cada 100k hab.)":
                display_cols += ['Poblacion', 'Tasa']
                df_disp_single['Poblacion'] = df_disp_single['Poblacion'].apply(lambda x: format_ar_number(x))
                df_disp_single['Tasa'] = df_disp_single['Tasa'].apply(lambda x: format_ar_number(x, 2))
            
            st.dataframe(df_disp_single[display_cols].sort_values('Casos', ascending=False), hide_index=True, use_container_width=True)
        else:
            st.warning("No hay datos para esta provincia.")

    st.info("Nota: Los datos de población son proyecciones del INDEC (Ambos Sexos) para el año seleccionado.")
else:
    st.info("👋 Bienvenid@. Seleccione los filtros en la barra lateral y presione 'Generar Tablero' para visualizar los datos.")
