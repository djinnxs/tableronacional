# --- UTILS ---
def query_data(sql_query, parquet_path=None):
    """Executa SQL directamente con DuckDB. parquet_path es ignorado — el path ya viene en el SQL."""
    try:
        with duckdb.connect() as con:
            return con.execute(sql_query).df()
    except Exception as e:
        st.error(f"Error al consultar datos: {e}")
        return pd.DataFrame()

@st.cache_data
def load_geojson(path):
    with open(path, 'r', encoding='utf-8') as f:
        return json.load(f)

# --- DATA PATHS ---
BASE_PARQUET = 'data/base_nacional.parquet'
