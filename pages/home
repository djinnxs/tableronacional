# --- MAIN LOGIC ---
if st.session_state.get("generate_map"):
    # --- DATA QUERYING ---
    def get_main_data():
        where_clauses = [f"ANIO = {selected_anio}"]
        if selected_semanas and "Todas" not in selected_semanas:
            semanas_str = ", ".join(map(str, selected_semanas))
            where_clauses.append(f"SEMANA IN ({semanas_str})")
        if selected_event_ids:
            ids_str = ", ".join(map(str, selected_event_ids))
            where_clauses.append(f"ID_SNVS_EVENTO IN ({ids_str})")
        
        where_str = " AND ".join(where_clauses)
        
        # Query total cases first
        total_sql = f"SELECT SUM(CANTIDAD) FROM '{BASE_PARQUET}' WHERE {where_str}"
        total_matching = query_data(total_sql, BASE_PARQUET).iloc[0,0] if not query_data(total_sql, BASE_PARQUET).empty else 0
        
        # Dataframes to return
        df_prov = pd.DataFrame()
        df_depto = pd.DataFrame()

        # Always fetch provincial data
        sql_prov = f"""
        SELECT id_provincia, Provincia, SUM(CANTIDAD) as Casos 
        FROM '{BASE_PARQUET}' 
        WHERE {where_str} AND id_provincia != '00'
        GROUP BY id_provincia, Provincia
        """
        df_prov = query_data(sql_prov, BASE_PARQUET)
        if not df_prov.empty:
            df_prov['id_provincia'] = df_prov['id_provincia'].astype(str).str.zfill(2)
            # Filter population by sexo_nombre = 'Ambos sexos' to avoid double counting
            pop_prov_sql = f"SELECT juri as id_provincia, SUM(poblacion) as Poblacion FROM '{PROV_POP_PARQUET}' WHERE ano = {selected_anio} AND sexo_nombre = 'Ambos sexos' GROUP BY juri"
            pop_prov = query_data(pop_prov_sql, PROV_POP_PARQUET)
            if not pop_prov.empty:
                pop_prov['id_provincia'] = pop_prov['id_provincia'].astype(str).str.zfill(2)
            df_prov = df_prov.merge(pop_prov, on='id_provincia', how='left')
            df_prov['Poblacion'] = pd.to_numeric(df_prov['Poblacion'], errors='coerce').fillna(0)
            df_prov['Tasa'] = (df_prov['Casos'] / df_prov['Poblacion'] * 100000).fillna(0)

        # Fetch departmental data (either for one province or for the whole country)
        depto_where = where_str
        if provincia_filter != "Nacional":
            depto_where += f" AND Provincia = '{provincia_filter}'"
        
        sql_depto = f"""
        SELECT id_departamento, Departamento, Provincia, SUM(CANTIDAD) as Casos 
        FROM '{BASE_PARQUET}' 
        WHERE {depto_where} AND id_departamento NOT LIKE '%000'
        GROUP BY id_departamento, Departamento, Provincia
        """
        df_depto = query_data(sql_depto, BASE_PARQUET)
        if not df_depto.empty:
            df_depto['id_departamento'] = df_depto['id_departamento'].astype(str).str.zfill(5)
            # Filter population by sexo_nombre = 'Ambos sexos'
            pop_depto_sql = f"SELECT juri_codigo, departamento_codigo, SUM(poblacion) as Poblacion FROM '{DEPTO_POP_PARQUET}' WHERE ano = {selected_anio} AND sexo_nombre = 'Ambos sexos' GROUP BY juri_codigo, departamento_codigo"
            pop_depto = query_data(pop_depto_sql, DEPTO_POP_PARQUET)
            if not pop_depto.empty:
                pop_depto['id_departamento'] = pop_depto['juri_codigo'].astype(str).str.zfill(2) + pop_depto['departamento_codigo'].astype(str).str.zfill(3)
                df_depto = df_depto.merge(pop_depto[['id_departamento', 'Poblacion']], on='id_departamento', how='left')
                df_depto['Poblacion'] = pd.to_numeric(df_depto['Poblacion'], errors='coerce').fillna(0)
                df_depto['Tasa'] = (df_depto['Casos'] / df_depto['Poblacion'] * 100000).fillna(0)

        casos_sin_loc = total_matching - df_prov['Casos'].sum() if not df_prov.empty else total_matching
        return df_prov, df_depto, casos_sin_loc

    df_prov, df_depto, casos_sin_loc = get_main_data()

    # --- DASHBOARD MAIN CONTENT ---
    if selected_event_ids:
        eventos_label = ", ".join([eventos_dict[id] for id in selected_event_ids])
    else:
        eventos_label = "Todos los eventos"
        
    st.markdown(f"<h1 class='premium-header'>Análisis Epidemiológico</h1>", unsafe_allow_html=True)
    st.markdown(f"### {eventos_label}")

    semanas_label = "Todas" if "Todas" in selected_semanas else (", ".join(map(str, sorted(selected_semanas))) if selected_semanas else "Sin selección")
    st.markdown(f"**Año:** {selected_anio} | **Semana(s):** {semanas_label} | **Jurisdicción:** {provincia_filter}")

    col1, col2, col3 = st.columns(3)
    # Metrics logic: use provincial data for totals
    if not df_prov.empty:
        total_casos_loc = int(df_prov['Casos'].sum())
        total_pop = int(df_prov['Poblacion'].sum())
        avg_tasa = (total_casos_loc / total_pop * 100000) if total_pop > 0 else 0
    else:
        total_casos_loc, total_pop, avg_tasa = 0, 0, 0

    with col1:
        st.metric("Casos con Ref. Geográfica", f"{total_casos_loc:,}")
    with col2:
        st.metric("Población (Ambos Sexos)", f"{total_pop:,}")
    with col3:
        st.metric("Tasa x 100k hab.", f"{avg_tasa:.2f}")

    if casos_sin_loc > 0:
        st.warning(f"⚠️ **Atención:** Se detectaron **{int(casos_sin_loc):,}** casos sin referencia geográfica asignada para los filtros seleccionados.")

    # --- MAPPING ---
    st.subheader("Distribución Geográfica")

    # Determine color scale
    color_col = 'Casos' if metric_option == "Casos" else 'Tasa'
    color_scale = "Reds" if metric_option == "Casos" else "Blues"

    if provincia_filter == "Nacional":
        m_col1, m_col2 = st.columns(2)
        
        with m_col1:
            st.markdown("##### Nivel Provincial")
            geojson_prov = load_geojson(PROV_GEOJSON)
            if not df_prov.empty:
                # Ensure Tasa and Poblacion exist even if pop lookup failed
                if 'Tasa' not in df_prov.columns:
                    df_prov['Tasa'] = 0.0
                if 'Poblacion' not in df_prov.columns:
                    df_prov['Poblacion'] = 0
                fig_prov = px.choropleth_mapbox(
                    data_frame=df_prov, geojson=geojson_prov, locations='id_provincia',
                    featureidkey='properties.in1', color=color_col, hover_name='Provincia',
                    hover_data=['Casos', 'Tasa', 'Poblacion'], color_continuous_scale=color_scale,
                    mapbox_style="carto-positron", zoom=3, center={"lat": -38.4161, "lon": -63.6167},
                    opacity=0.7, labels={'Casos': 'N° Casos', 'Tasa': 'Tasa'}
                )
                fig_prov.update_layout(margin={"r":0,"t":0,"l":0,"b":0}, height=500)
                st.plotly_chart(fig_prov, use_container_width=True)
                
                # Dynamic table columns based on metric
                display_cols = ['Provincia', 'Casos']
                df_disp = df_prov.copy()
                if metric_option == "Tasas (cada 100k hab.)":
